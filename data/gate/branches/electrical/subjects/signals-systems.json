      "id": "gate-ee-sign-q1",
      "testId": "gate-subject-electrical-signals-systems",
      "year": 2024,
      "orderIndex": 1,
      "section": "EE",
      "title": "GATE EE — Signals | LTI Systems, Convolution & Impulse Response",
      "subject": "Signals & Systems",
      "subjectSlug": "signals-systems",
      "topic": "LTI Systems, Convolution & Impulse Response",
      "type": "MCQ",
      "question": "<p>A continuous-time LTI system with impulse response $h(t) = e^{-2t} u(t)$ is:</p>",
      "options": [
        "Both causal and BIBO stable",
        "Causal but BIBO unstable",
        "Non-causal but BIBO stable",
        "Neither causal nor stable"
      ],
      "structuredOptions": [
        {
          "label": "A",
          "text": "Both causal and BIBO stable",
          "html": "Both causal and BIBO stable"
        },
        {
          "label": "B",
          "text": "Causal but BIBO unstable",
          "html": "Causal but BIBO unstable"
        },
        {
          "label": "C",
          "text": "Non-causal but BIBO stable",
          "html": "Non-causal but BIBO stable"
        },
        {
          "label": "D",
          "text": "Neither causal nor stable",
          "html": "Neither causal nor stable"
        }
      ],
      "answer": [
        "A"
      ],
      "tolerance": null,
      "marks": 1,
      "negativeMarks": 0.33,
      "explanation": "<div class='space-y-2'><p><strong>Step-by-Step Solution (Signals & Systems):</strong></p><p>Causality: $h(t) = 0$ for $t < 0$ due to $u(t)$. Stability: $\\int_{-\\infty}^{\\infty} |h(t)| dt = \\int_0^\\infty e^{-2t} dt = \\left[-\\frac{e^{-2t}}{2}\\right]_0^\\infty = \\frac{1}{2} < \\infty$. Hence both causal and BIBO stable.</p></div>"
    },
